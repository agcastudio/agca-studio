{
  // Cloudflare Workers — statik site (Hugo çıktısı public/ klasöründen sunulur)
  // Cloudflare panelinde: Build command = hugo --gc --minify · Deploy command = npx wrangler deploy · HUGO_VERSION = 0.166.0
  "name": "agca-studio",
  "compatibility_date": "2026-09-01",
  // Kopya ana makine olmasın diye: site yalnız agca.studio özel alan adından sunulur.
  // workers.dev ve sürüm önizleme adresleri sitenin birebir kopyasını sunuyordu; Google
  // "Kopya, farklı standart sayfa seçildi" uyarısı verdi (2026-09-24).
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./public",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  }
}
