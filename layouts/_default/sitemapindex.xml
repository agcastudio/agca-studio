{{ printf "<?xml version=\"1.0\" encoding=\"utf-8\" standalone=\"yes\"?>" | safeHTML }}
{{- /* Kök /sitemap.xml: iki dilin sayfalarını TEK düz liste olarak verir.
       Hugo'nun varsayılanı dil başına alt harita üretip indekslerdi; ama /tr/sitemap.xml kök dizindeki
       adresleri listeliyordu ve site haritası kapsam kuralına göre bu belirsiz bir durumdu. */ -}}
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9" xmlns:xhtml="http://www.w3.org/1999/xhtml" xmlns:image="http://www.google.com/schemas/sitemap-image/1.1">
  {{- range . }}
  {{- range .Pages }}
  {{- $p := . }}
  <url>
    <loc>{{ .Permalink }}</loc>
    {{- if not .Lastmod.IsZero }}
    <lastmod>{{ .Lastmod.Format "2006-01-02T15:04:05-07:00" | safeHTML }}</lastmod>
    {{- end }}
    {{- with .Sitemap.ChangeFreq }}
    <changefreq>{{ . }}</changefreq>
    {{- end }}
    {{- if ge .Sitemap.Priority 0.0 }}
    <priority>{{ .Sitemap.Priority }}</priority>
    {{- end }}
    {{- if .IsTranslated }}
    {{- range .AllTranslations }}
    <xhtml:link rel="alternate" hreflang="{{ .Language.Lang }}" href="{{ .Permalink }}"/>
    {{- end }}
    {{- end }}
    {{- range partial "sayfa-gorselleri.html" $p }}
    <image:image><image:loc>{{ . }}</image:loc></image:image>
    {{- end }}
  </url>
  {{- end }}
  {{- end }}
</urlset>
